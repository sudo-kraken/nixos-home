{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergePr",
    ":automergePatch",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(Europe/London)",
    "github>sudo-kraken/nixos-home//.github/renovate/labels.json5",
    "github>sudo-kraken/nixos-home//.github/renovate/semantic_commits.json5",
  ],
  "nix": {
    "enabled": true,
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false,
  },
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "suppressNotifications": ["prEditedNotification", "prIgnoreNotification"],
  "rebaseWhen": "conflicted",
  "schedule": [
    "before 9pm on friday",
  ],
  "labels": [
    "dependencies",
  ]
}
